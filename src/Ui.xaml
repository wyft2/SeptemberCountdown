                                           FontSize="9.5" Foreground="#90A0B6" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="SecondsToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          AutomationProperties.Name="显示秒数开关"/>
                        </Grid>

                        <Grid Height="57">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自启动" FontFamily="Microsoft YaHei UI" FontSize="12.5"
                                           Foreground="#E6ECF6"/>
                                <TextBlock Text="登录 Windows 后自动启动倒计时" FontFamily="Microsoft YaHei UI"
                                           FontSize="9.5" Foreground="#90A0B6" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          AutomationProperties.Name="开机自启动开关"/>
                        </Grid>

                        <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,14"/>

                        <TextBlock Text="星空模式" FontFamily="Microsoft YaHei UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#9DAABE"/>

                        <Grid Height="51">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开启星空模式" FontFamily="Microsoft YaHei UI" FontSize="12.5"
                                           Foreground="#E6ECF6"/>
