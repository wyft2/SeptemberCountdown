                                   Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="27,12,22,18">
                    <Button x:Name="ResetButton" Style="{StaticResource LinkButton}" Content="恢复默认"
