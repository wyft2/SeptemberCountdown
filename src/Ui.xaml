                                          AutomationProperties.Name="数字流沙开关"/>
                        </Grid>

                        <TextBlock Text="流光可以和玻璃/流沙叠加；透明玻璃数字与数字流沙互斥，开启一个会自动关闭另一个。"
                                   FontFamily="Microsoft YaHei UI" FontSize="9.5" Foreground="#8A99AF"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14"/>

                        <TextBlock Text="窗口行为" FontFamily="Microsoft YaHei UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#9DAABE"/>

                        <Grid Height="51">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="桌面置顶" FontFamily="Microsoft YaHei UI" FontSize="12.5"
                                           Foreground="#E6ECF6"/>
                                <TextBlock Text="让倒计时悬浮在其他窗口上方，随时可见" FontFamily="Microsoft YaHei UI"
                                           FontSize="9.5" Foreground="#90A0B6" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="TopmostToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          AutomationProperties.Name="桌面置顶开关"/>
                        </Grid>

                        <Grid Height="51">
