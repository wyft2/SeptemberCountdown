                                                <GradientStop Color="#84CC16" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="森林" FontFamily="Microsoft YaHei UI" FontSize="10"
