                                    <Border Height="28" CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF7EB6" Offset="0"/>
                                                <GradientStop Color="#C084FC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="樱花" FontFamily="Microsoft YaHei UI" FontSize="10"
