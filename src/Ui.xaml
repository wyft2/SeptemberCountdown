                                               HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#C9D4E4"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeMint" Style="{StaticResource ThemeButton}" Tag="mint"
                                    AutomationProperties.Name="薄荷配色">
