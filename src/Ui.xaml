                                    <Border Height="28" CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#34D399" Offset="0"/>
                                                <GradientStop Color="#22D3EE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="薄荷" FontFamily="Microsoft YaHei UI" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#C9D4E4"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

