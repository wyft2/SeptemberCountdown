    <!-- Countdown right-click menu -->
    <Popup x:Name="CountdownPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="Fade" IsOpen="False">
        <Border Background="#F50C1119" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="12"
                Padding="5" MinWidth="168">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="#B3000000" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <Button x:Name="MenuSettingsButton" Style="{StaticResource MenuRowButton}" Content="设置…"/>
                <Button x:Name="MenuTopmostButton" Style="{StaticResource MenuRowButton}" Content="桌面置顶"/>
                <Button x:Name="MenuUpdateButton" Style="{StaticResource MenuRowButton}" Content="检查更新…"/>
                <Button x:Name="MenuExitButton" Style="{StaticResource MenuRowButton}" Content="退出九月倒计时"/>
            </StackPanel>
        </Border>
    </Popup>

    <!-- Easter egg toast -->
    <Border x:Name="EggToast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,26,0,0" Padding="18,10" CornerRadius="14" Background="#F00B1220"
            BorderBrush="#4DFFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#99000000" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                       Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
            <TextBlock Text="已进入彩蛋模式" FontFamily="Microsoft YaHei UI" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#F5F7FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>

    <!-- Easter egg menu -->
    <Grid x:Name="EggOverlay" Visibility="Collapsed" Background="#B3030A12">
        <Border x:Name="EggPanel" Width="368" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FB0A0F18" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="22"
                Padding="24,22,24,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="10" Direction="270" Color="#CC000000" Opacity="0.65"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="EASTER EGG · 彩蛋" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="已进入彩蛋模式" FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#F7F9FF" Margin="0,7,0,0"/>
                        <TextBlock Text="既然发现了这里，就选一条路继续吧。" FontFamily="Microsoft YaHei UI" FontSize="10.5"
                                   Foreground="#9DABBF" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button x:Name="EggCloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" ToolTip="关闭彩蛋菜单" AutomationProperties.Name="关闭彩蛋菜单">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button x:Name="EggAuthorButton" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,0,9"
