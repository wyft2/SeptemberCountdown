                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="作者主页" FontFamily="Microsoft YaHei UI" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
