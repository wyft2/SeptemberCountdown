<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root"
      Background="#01000000"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="Grayscale"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentColor" Color="#A78BFA"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#337C5CFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E9AB4"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5E6A82"/>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F20D121C" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#A9B3C7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#A9B3C7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                                <Ellipse x:Name="ActiveDot" Width="3" Height="3" Fill="{DynamicResource AccentColor}"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"
                                         Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter TargetName="ActiveDot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="SelectionBrush" Value="#668B5CF6"/>
            <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" Background="Transparent"
                                          BorderBrush="Transparent" BorderThickness="0" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A9B4CA"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="26">
                            <Border x:Name="Track" CornerRadius="13" Background="#1AFFFFFF"
                                    BorderBrush="#28FFFFFF" BorderThickness="1"/>
                            <Border x:Name="OnFill" CornerRadius="13" Background="{DynamicResource AccentBrush}"
                                    Opacity="0"/>
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="#F4F7FF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                      Color="#66000000" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OnFill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#27FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeButton" TargetType="Button">
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#8E9AB4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="5,5,5,6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CAD3E4"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0BFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="Shine" Background="#FFFFFF" CornerRadius="10" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#6F7C94"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8D2E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="6" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3DFFFFFF" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#16FFFFFF" BorderBrush="#1AFFFFFF"
                                    BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#66FFFFFF" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DigitLayer" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SandLayer" TargetType="Rectangle">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <!-- Liquid colour field -->
    <Canvas x:Name="BlobCanvas" ClipToBounds="True" IsHitTestVisible="False">
        <Ellipse x:Name="BlobA" Width="560" Height="560" Canvas.Left="-170" Canvas.Top="-230" Opacity="0.82">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.38,0.36" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#D97C5CFF" Offset="0"/>
                    <GradientStop Color="#8C6C4CF6" Offset="0.34"/>
                    <GradientStop Color="#337C5CFF" Offset="0.67"/>
                    <GradientStop Color="#007C5CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="BlobATransform" X="0" Y="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="-20" To="110" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="-10" To="95" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobA" Storyboard.TargetProperty="Opacity"
                                             From="0.72" To="0.92" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Ellipse x:Name="BlobB" Width="500" Height="500" Canvas.Left="455" Canvas.Top="185" Opacity="0.8">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.58,0.42" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#CC13D9F5" Offset="0"/>
                    <GradientStop Color="#8010BFD9" Offset="0.36"/>
                    <GradientStop Color="#2E13D9F5" Offset="0.68"/>
                    <GradientStop Color="#0013D9F5" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="BlobBTransform" X="0" Y="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="40" To="-125" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="20" To="-85" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobB" Storyboard.TargetProperty="Opacity"
                                             From="0.66" To="0.88" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Ellipse x:Name="BlobC" Width="470" Height="470" Canvas.Left="55" Canvas.Top="330" Opacity="0.66">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#C6FF5FA2" Offset="0"/>
                    <GradientStop Color="#70E6458C" Offset="0.36"/>
                    <GradientStop Color="#26FF5FA2" Offset="0.68"/>
                    <GradientStop Color="#00FF5FA2" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="BlobCTransform" X="0" Y="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="BlobC" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="-60" To="145" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobC" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="40" To="-70" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Ellipse x:Name="BlobD" Width="380" Height="380" Canvas.Left="555" Canvas.Top="-160" Opacity="0.58">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.45,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#B8FFB86B" Offset="0"/>
                    <GradientStop Color="#58FF9D54" Offset="0.38"/>
                    <GradientStop Color="#1CFFB86B" Offset="0.7"/>
                    <GradientStop Color="#00FFB86B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="BlobDTransform" X="0" Y="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="BlobD" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="30" To="-100" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobD" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="-20" To="120" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Canvas>

    <!-- A quiet liquid aura used by the transparent display mode -->
    <Grid x:Name="MinimalGlow" Visibility="Collapsed" IsHitTestVisible="False">
        <Ellipse Width="600" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.72">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#20FFFFFF" Offset="0"/>
                    <GradientStop Color="#0EFFFFFF" Offset="0.55"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="230" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="-170,-66,0,0" Opacity="0.6">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="-170,0,0,0" Opacity="0.58">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#A08B5CF6" Offset="0"/>
                    <GradientStop Color="#3B8B5CF6" Offset="0.48"/>
                    <GradientStop Color="#008B5CF6" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="MinimalGlowShift" X="-18" Y="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="MinimalGlowShift"
                                             Storyboard.TargetProperty="X" From="-18" To="28"
                                             Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MinimalGlowShift"
                                             Storyboard.TargetProperty="Y" From="-6" To="10"
                                             Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <Ellipse Width="460" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="210,0,0,0" Opacity="0.44">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#A013D9F5" Offset="0"/>
                    <GradientStop Color="#3813D9F5" Offset="0.5"/>
                    <GradientStop Color="#0013D9F5" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>

    <!-- Deepens the edges so the glass feels dimensional -->
    <Border x:Name="EdgeShade" IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28040A12" Offset="0"/>
                <GradientStop Color="#10040A12" Offset="0.32"/>
                <GradientStop Color="#38040A12" Offset="0.78"/>
                <GradientStop Color="#6E04080F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
    </Border>

    <!-- Frosted grain -->
    <Border x:Name="NoiseLayer" IsHitTestVisible="False" Opacity="0.055">
        <Border.Background>
            <ImageBrush x:Name="NoiseBrush" TileMode="Tile" Viewport="0,0,190,190" ViewportUnits="Absolute"
                        Stretch="None"/>
        </Border.Background>
    </Border>

    <!-- Top bar -->
    <Grid x:Name="TopBar" Height="60" VerticalAlignment="Top" Margin="24,0,20,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#22D3EE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#998B5CF6" Opacity="0.55"/>
                </Border.Effect>
                <TextBlock Text="九" FontFamily="Microsoft YaHei UI" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" ToolTip="桌面置顶"
                          AutomationProperties.Name="桌面置顶">
                <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12.5"/>
            </ToggleButton>
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="设置"
                    AutomationProperties.Name="设置">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <Button x:Name="MinButton" Style="{StaticResource IconButton}" ToolTip="收起到托盘"
                    AutomationProperties.Name="最小化到托盘">
                <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" ToolTip="退出"
                    AutomationProperties.Name="退出">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
            </Button>
        </StackPanel>
    </Grid>

    <!-- Soft shadow sits behind the glass so the glass itself stays translucent -->
    <Border x:Name="CardShadow" Margin="30,74,30,60" CornerRadius="34" Background="#66000000" IsHitTestVisible="False"
            Opacity="0.8">
        <Border.Effect>
            <BlurEffect Radius="34" RenderingBias="Performance"/>
        </Border.Effect>
    </Border>

    <!-- Countdown glass card -->
    <Border x:Name="MainCard" Margin="24,68,24,54" CornerRadius="30" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E8B5CF6" Offset="0"/>
                <GradientStop Color="#12FFFFFF" Offset="0.3"/>
                <GradientStop Color="#08FFFFFF" Offset="0.62"/>
                <GradientStop Color="#1A13D9F5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5CFFFFFF" Offset="0"/>
                <GradientStop Color="#1EFFFFFF" Offset="0.36"/>
                <GradientStop Color="#14FFFFFF" Offset="0.72"/>
                <GradientStop Color="#2EFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Ellipse x:Name="CardVioletGlow" Width="470" Height="360" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="-125,25,0,0" IsHitTestVisible="False" Opacity="0.28">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.45,0.45" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#A08B5CF6" Offset="0"/>
                        <GradientStop Color="#408B5CF6" Offset="0.46"/>
                        <GradientStop Color="#008B5CF6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="CardCyanGlow" Width="440" Height="330" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,70,-115,0" IsHitTestVisible="False" Opacity="0.24">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#A013D9F5" Offset="0"/>
                        <GradientStop Color="#3A13D9F5" Offset="0.48"/>
                        <GradientStop Color="#0013D9F5" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="CardSpecularGlow" Width="440" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-115,-115,0" IsHitTestVisible="False" Opacity="0.32">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#80FFFFFF" Offset="0"/>
                        <GradientStop Color="#20FFFFFF" Offset="0.46"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="38" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="CardPurpleGlow" Width="340" Height="210" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-110,0,0,-120" IsHitTestVisible="False" Opacity="0.20">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#B08B5CF6" Offset="0"/>
                        <GradientStop Color="#388B5CF6" Offset="0.5"/>
                        <GradientStop Color="#008B5CF6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="30" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Border x:Name="CardTopHighlight" Height="1" VerticalAlignment="Top" Margin="44,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#A0FFFFFF" Offset="0.28"/>
                        <GradientStop Color="#46FFFFFF" Offset="0.62"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="CardContent" Margin="38,27,38,23">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel x:Name="NameStack" HorizontalAlignment="Left">
                        <Border x:Name="CountdownBadge" HorizontalAlignment="Left" CornerRadius="7" Background="#16FFFFFF"
                                BorderBrush="#24FFFFFF" BorderThickness="1" Padding="8,4,9,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="8.5" Foreground="#B5C1D5" VerticalAlignment="Center"/>
                                <TextBlock Text="COUNTDOWN" FontFamily="Segoe UI" FontSize="8.5"
                                           Foreground="#B5C1D5" FontWeight="SemiBold" Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NameText" Text="新年倒计时" FontFamily="Microsoft YaHei UI"
                                   FontSize="25" FontWeight="SemiBold" Foreground="#F7F9FF"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis" MaxWidth="390"/>
                    </StackPanel>

                    <StackPanel x:Name="TopRightInfo" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="12"
                                Background="#1422C55E" BorderBrush="#3322C55E" BorderThickness="1"
                                Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#4ADE80"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#AA4ADE80" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="进行中" FontFamily="Microsoft YaHei UI"
                                           FontSize="10" Foreground="#B7F5D8" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TargetText" Text="目标 · 2027.01.01 00:00" FontFamily="Segoe UI"
                                   FontSize="10.5" Foreground="#B4C0D3" HorizontalAlignment="Right" Margin="0,9,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid x:Name="DaysHost" VerticalAlignment="Center">
                            <TextBlock x:Name="DaysText" Text="54" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="116" FontWeight="SemiBold" Foreground="#F8FAFF"
                                       LineHeight="118" LineStackingStrategy="BlockLineHeight"
                                       Typography.NumeralAlignment="Tabular">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#508B5CF6" Opacity="0.45"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Rectangle x:Name="DaysSand" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="DaysSandFine" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="DaysSandFlow" Style="{StaticResource SandLayer}"/>
                            <TextBlock x:Name="DaysRim" Style="{StaticResource DigitLayer}" Text="54"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="116"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF" LineHeight="118"
                                       LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="DaysSheen" Style="{StaticResource DigitLayer}" Text="54"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="116"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF" LineHeight="118"
                                       LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <StackPanel x:Name="DayUnitPanel" VerticalAlignment="Bottom" Margin="12,0,0,29">
                            <TextBlock x:Name="DayUnitText" Text="天" FontFamily="Microsoft YaHei UI" FontSize="17"
                                       Foreground="#DDE5F2" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DayUnitCaption" Text="D A Y S" FontFamily="Segoe UI" FontSize="8"
                                       Foreground="#AAB7CA" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ClockRow" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,-3,0,0">
                        <Grid x:Name="HoursHost" VerticalAlignment="Center">
                            <TextBlock x:Name="HoursText" Text="12" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="43" FontWeight="SemiBold" Foreground="#DFE7F8"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            <Rectangle x:Name="HoursSand" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="HoursSandFine" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="HoursSandFlow" Style="{StaticResource SandLayer}"/>
                            <TextBlock x:Name="HoursRim" Style="{StaticResource DigitLayer}" Text="12"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="HoursSheen" Style="{StaticResource DigitLayer}" Text="12"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <TextBlock x:Name="Colon1" Text=":" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36"
                                   Foreground="#9DAABE" Margin="7,0,7,3" VerticalAlignment="Center"/>
                        <Grid x:Name="MinutesHost" VerticalAlignment="Center">
                            <TextBlock x:Name="MinutesText" Text="34" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="43" FontWeight="SemiBold" Foreground="#DFE7F8"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            <Rectangle x:Name="MinutesSand" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="MinutesSandFine" Style="{StaticResource SandLayer}"/>
                            <Rectangle x:Name="MinutesSandFlow" Style="{StaticResource SandLayer}"/>
                            <TextBlock x:Name="MinutesRim" Style="{StaticResource DigitLayer}" Text="34"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="MinutesSheen" Style="{StaticResource DigitLayer}" Text="34"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                       FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <StackPanel x:Name="SecondsGroup" Orientation="Horizontal">
                            <TextBlock x:Name="Colon2" Text=":" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36"
                                       Foreground="#9DAABE" Margin="7,0,7,3" VerticalAlignment="Center"/>
                            <Grid x:Name="SecondsHost" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="SecondsTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>
                                <TextBlock x:Name="SecondsText" Text="56" FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="43" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                <Rectangle x:Name="SecondsSand" Style="{StaticResource SandLayer}"/>
                                <Rectangle x:Name="SecondsSandFine" Style="{StaticResource SandLayer}"/>
                                <Rectangle x:Name="SecondsSandFlow" Style="{StaticResource SandLayer}"/>
                                <TextBlock x:Name="SecondsRim" Style="{StaticResource DigitLayer}" Text="56"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                           FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="SecondsSheen" Style="{StaticResource DigitLayer}" Text="56"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="43"
                                           FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="ProgressArea" Grid.Row="2">
                    <ProgressBar x:Name="Progress" Style="{StaticResource GlassProgress}" Minimum="0" Maximum="100"
                                 Value="0" VerticalAlignment="Center"/>
                    <Grid Margin="0,13,0,0">
                        <TextBlock x:Name="ProgressText" Text="时间进度 0.0%" FontFamily="Microsoft YaHei UI"
                                   FontSize="10" Foreground="#9DAABE"/>
                        <TextBlock x:Name="RemainingHint" Text="还剩 54 天" FontFamily="Microsoft YaHei UI"
                                   FontSize="10" Foreground="#B0BDD0" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- Footer -->
    <Grid x:Name="Footer" Height="34" VerticalAlignment="Bottom" Margin="32,0,32,16" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="8.5" Foreground="#668B5CF6"
                       VerticalAlignment="Center"/>
            <TextBlock Text="拖动移动  ·  双击打开设置" FontFamily="Microsoft YaHei UI" FontSize="10"
                       Foreground="#A6B3C6" Margin="7,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="powered by" FontFamily="Segoe UI" FontSize="10" Foreground="#A6B3C6"
                       VerticalAlignment="Center"/>
            <TextBlock Text="九月" FontFamily="Microsoft YaHei UI" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}" Margin="5,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="8" Foreground="#66FFFFFF"
                       Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>

    <!-- Settings overlay -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#77030912">
        <Border x:Name="SettingsPanel" Width="418" HorizontalAlignment="Right" Background="#F5080C14"
                BorderBrush="#2AFFFFFF" BorderThickness="1,0,0,0" CornerRadius="24,0,0,24">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsSlide" X="430"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="27,21,19,12">
                    <StackPanel>
                        <TextBlock Text="设置" FontFamily="Microsoft YaHei UI" FontSize="21" FontWeight="SemiBold"
                                   Foreground="#F7F9FF"/>
                        <TextBlock Text="自定义你的倒计时 · powered by 九月" FontFamily="Microsoft YaHei UI"
                                   FontSize="10" Foreground="#8B99B0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="SettingsCloseButton" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭设置"
                            AutomationProperties.Name="关闭设置">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Padding="27,4,12,7">
                    <StackPanel>
                        <TextBlock Text="内容与时间" FontFamily="Microsoft YaHei UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#9DAABE"/>
                        <TextBlock Text="倒计时文本" FontFamily="Microsoft YaHei UI" FontSize="11"
                                   Foreground="#B0BDD0" Margin="0,13,0,6"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" MaxLength="40"
                                 Text="新年倒计时" AutomationProperties.Name="倒计时文本"/>
                        <TextBlock Text="最多 40 个字符，会同步显示在卡片上" FontFamily="Microsoft YaHei UI"
                                   FontSize="9.5" Foreground="#8A99AF" Margin="0,5,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="目标日期" FontFamily="Microsoft YaHei UI" FontSize="11"
                                           Foreground="#B0BDD0" Margin="0,0,0,6"/>
                                <TextBox x:Name="DateBox" Style="{StaticResource GlassTextBox}" Text="2027-01-01"
                                         AutomationProperties.Name="目标日期"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标时间" FontFamily="Microsoft YaHei UI" FontSize="11"
                                           Foreground="#B0BDD0" Margin="0,0,0,6"/>
                                <TextBox x:Name="TimeBox" Style="{StaticResource GlassTextBox}" Text="00:00"
                                         AutomationProperties.Name="目标时间"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,9,0,0">
                            <TextBlock Text="快速设定" FontFamily="Microsoft YaHei UI" FontSize="10"
                                       Foreground="#8A99AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="PresetHourButton" Style="{StaticResource ChipButton}" Content="1 小时后"
                                    Tag="hour"/>
                            <Button x:Name="PresetTomorrowButton" Style="{StaticResource ChipButton}" Content="明天此刻"
                                    Tag="tomorrow"/>
                            <Button x:Name="PresetNewYearButton" Style="{StaticResource ChipButton}" Content="下个元旦"
                                    Tag="newyear"/>
                        </WrapPanel>

                        <TextBlock x:Name="ValidationText" Text="" FontFamily="Microsoft YaHei UI" FontSize="10"
                                   Foreground="#FF8A9B" Margin="1,7,0,0" TextWrapping="Wrap"/>

                        <Border Height="1" Background="#14FFFFFF" Margin="0,14,0,14"/>

                        <TextBlock Text="显示效果" FontFamily="Microsoft YaHei UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#9DAABE"/>
                        <UniformGrid Columns="3" Margin="0,9,0,0">
                            <Button x:Name="EffectGlass" Style="{StaticResource ThemeButton}" Tag="glass"
                                    Margin="0,0,7,0" AutomationProperties.Name="液态玻璃效果">
                                <StackPanel>
                                    <Border Height="28" CornerRadius="8" Background="#22FFFFFF">
                                        <TextBlock Text="53" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="液态玻璃" FontFamily="Microsoft YaHei UI" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#C9D4E4"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="EffectLiquid" Style="{StaticResource ThemeButton}" Tag="liquid"
                                    Margin="0,0,7,0" AutomationProperties.Name="液态透明效果">
                                <StackPanel>
                                    <Border Height="28" CornerRadius="8">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.35,0.5" Center="0.5,0.5"
                                                                 RadiusX="0.65" RadiusY="0.8">
                                                <GradientStop Color="#A08B5CF6" Offset="0"/>
                                                <GradientStop Color="#4213D9F5" Offset="0.58"/>
                                                <GradientStop Color="#0A13D9F5" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="53" FontFamily="Segoe UI Variable Display, Segoe UI"
