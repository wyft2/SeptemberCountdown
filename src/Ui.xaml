                            </StackPanel>
                            <ToggleButton x:Name="StarModeToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          AutomationProperties.Name="星空模式开关"/>
                        </Grid>

                        <StackPanel x:Name="StarIdlePanel" Visibility="Collapsed">
                            <Grid Height="56">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="待机时间" FontFamily="Microsoft YaHei UI" FontSize="12.5"
                                               Foreground="#E6ECF6"/>
