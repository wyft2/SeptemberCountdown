                                            VerticalAlignment="Center">
                                    <TextBox x:Name="StarIdleBox" Style="{StaticResource GlassTextBox}"
                                             Width="62" FontSize="12" Padding="8,6" MaxLength="3"
                                             TextAlignment="Center" Text="1"
                                             AutomationProperties.Name="星空待机分钟数"/>
                                    <TextBlock Text="分钟" FontFamily="Microsoft YaHei UI" FontSize="10"
                                               Foreground="#B0BDD0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="StarPreviewButton" Style="{StaticResource GhostButton}"
                                    Content="预览星空" Padding="12,5" FontSize="10.5"
                                    HorizontalAlignment="Left" Margin="0,2,0,0"
                                    AutomationProperties.Name="预览星空"/>
                            <TextBlock Text="进入星空后点击任意位置、按 Esc 或空格退出；不会影响倒计时目标时间。"
