                                <StackPanel>
                                    <Border Height="28" CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF5C38" Offset="0"/>
                                                <GradientStop Color="#FFB020" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="熔岩" FontFamily="Microsoft YaHei UI" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#C9D4E4"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeForest" Style="{StaticResource ThemeButton}" Tag="forest" Margin="0,0,7,0"
